#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
KIT="$(cd "$(dirname "$SELF")/.." && pwd)"
PROFILES="${DEV_AGENT_PROFILES:-$HOME/dev-agent-profiles}"
cmd="${1:-help}"
if [ $# -gt 0 ]; then shift; fi

usage() {
  cat >&2 <<'EOF'
usage: dev-agent <command> [args]

  doctor [repo]          diagnóstico de la instalación
  init [args]            instalador interactivo; acepta las flags de install.sh
  guard [args]           guard determinista del repo actual
  verify [args]          verify del repo actual
  review                 muestra el diff y el prompt de revisión
  review-gga [repo]      revisión GGA blocking (o pasar --advisory)
  eval [args]            eval harness neutral (OpenCode, Claude, Codex, pi, Hermes)
  roles <target> [args]  genera un agente por rol desde roles.json (claude, opencode)
  profile list           perfiles instalados
  profile use <name>     cambia el perfil activo
  profiles update        actualiza dev-agent-profiles (alias de update --profiles)
  update [args]          actualiza core y/o perfiles con --check/--target
  flow list              flujos disponibles en dev-agent-profiles
  flow run <name> [args] ejecuta un flujo (por ejemplo team) sobre el repo actual
  flow check <name> [args] valida el contrato o una tarea/evidencia del flujo
  codegraph [args]       codegraph sync del repo actual, o pasa args
  memory [args]          engram save/search/... del proyecto
EOF
}

case "$cmd" in
  help|-h|--help) usage ;;
  doctor) exec bash "$KIT/scripts/doctor.sh" "${1:-$PWD}" ;;
  init) exec bash "$KIT/install.sh" "$@" ;;
  guard) export GUARD_ROOT="${GUARD_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"; exec bash "$KIT/guard/guard.sh" "$@" ;;
  verify) export VERIFY_ROOT="${VERIFY_ROOT:-$PWD}"; exec bash "$KIT/verify/run.sh" "$@" ;;
  eval) exec python3 "$KIT/evals/harness.py" "$@" ;;
  roles)
    target="${1:?falta el target: claude u opencode}"
    shift
    roles_file="${DEV_AGENT_ROLES:-}"
    if [ -z "$roles_file" ]; then
      for candidate in "$PWD/.dev-agent/flows/team/roles.json" "$PWD/.dev-agent/profiles/team/roles.json" "$PWD/profiles/team/roles.json" "$PROFILES/flows/team/roles.json" "$PROFILES/profiles/team/roles.json"; do
        if [ -f "$candidate" ]; then roles_file="$candidate"; break; fi
      done
    fi
    if [ -z "$roles_file" ] && [[ " $* " != *" --roles "* ]]; then
      echo "roles: no encuentro roles.json del flujo team; pasa --roles <roles.json> o define DEV_AGENT_ROLES" >&2
      exit 2
    fi
    args=(--target "$target")
    [ -n "$roles_file" ] && args+=(--roles "$roles_file")
    exec python3 "$KIT/scripts/render-roles.py" "${args[@]}" "$@"
    ;;
  review)
    git diff --stat
    echo
    echo "Pide a tu agente: usa la skill review-diff sobre este diff; no edites."
    echo "La skill está en $KIT/skills/review-diff/SKILL.md"
    ;;
  review-gga)
    repo="$PWD"
    if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then repo="$1"; shift; fi
    exec bash "$KIT/scripts/review-gga.sh" "$repo" "$@"
    ;;
  profile)
    action="${1:-list}"
    if [ "$action" = "list" ]; then
      active=""
      [ -f "$PWD/.dev-agent/config" ] && active="$(sed -n 's/^DEV_AGENT_PROFILE=//p' "$PWD/.dev-agent/config")"
      if [ -d "$PWD/.dev-agent/profiles" ]; then
        find "$PWD/.dev-agent/profiles" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | while read -r name; do
          if [ "$name" = "$active" ]; then echo "* $name"; else echo "  $name"; fi
        done
      else
        echo "no hay perfiles en $PWD/.dev-agent/profiles"
      fi
    elif [ "$action" = "use" ]; then
      name="${2:-}"
      [ -n "$name" ] || { echo "falta el nombre del perfil" >&2; exit 2; }
      [ -f "$PWD/.dev-agent/profiles/$name/profile.env" ] || { echo "perfil no instalado: $name" >&2; exit 2; }
      mkdir -p "$PWD/.dev-agent"
      if [ -f "$PWD/.dev-agent/config" ]; then
        cp -a "$PWD/.dev-agent/config" "$PWD/.dev-agent/config.bak-$(date +%Y%m%d-%H%M%S)"
      fi
      printf 'DEV_AGENT_PROFILE=%s\n' "$name" >"$PWD/.dev-agent/config"
      if [ -f "$PWD/.dev-agent/profiles.lock" ]; then
        python3 - "$PWD/.dev-agent/profiles.lock" "$name" <<'PY'
import json
import sys
from pathlib import Path
path = Path(sys.argv[1])
data = json.loads(path.read_text(encoding="utf-8"))
data["active"] = sys.argv[2]
path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
      fi
      echo "perfil activo: $name"
    else
      usage
      exit 2
    fi
    ;;
  profiles)
    action="${1:-}"
    [ "$action" = "update" ] || { usage; exit 2; }
    shift
    exec bash "$KIT/scripts/update.sh" --profiles "$@"
    ;;
  flow)
    action="${1:-list}"
    shift || true
    flows_root="${DEV_AGENT_FLOWS:-$PROFILES/flows}"
    if [ "$action" = "list" ]; then
      found=0
      if [ -d "$flows_root" ]; then
        for flow_dir in "$flows_root"/*; do
          [ -f "$flow_dir/flow.json" ] || continue
          found=1
          python3 - "$flow_dir" <<'PY'
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
data = json.loads((path / "flow.json").read_text(encoding="utf-8"))
print("%-12s %-8s %s" % (data.get("name", path.name), data.get("version", "?"), data.get("description", "")))
PY
        done
      fi
      [ "$found" = "1" ] || echo "no hay flujos en $flows_root"
    elif [ "$action" = "check" ]; then
      name="${1:-}"
      [ -n "$name" ] || { echo "falta el nombre del flujo" >&2; exit 2; }
      shift
      flow_dir=""
      for candidate in "$PWD/.dev-agent/flows/$name" "$flows_root/$name"; do
        if [ -f "$candidate/flow.json" ]; then flow_dir="$candidate"; break; fi
      done
      [ -n "$flow_dir" ] || { echo "flujo no encontrado: $name" >&2; exit 2; }
      check="$(python3 - "$flow_dir/flow.json" <<'PY'
import json, sys
from pathlib import Path
print(json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("check", "guard/team_lint.py"))
PY
)"
      [ -f "$flow_dir/$check" ] || { echo "falta el check del flujo: $flow_dir/$check" >&2; exit 2; }
      exec python3 "$flow_dir/$check" --flow "$flow_dir" "$@"
    elif [ "$action" = "run" ]; then
      name="${1:-}"
      [ -n "$name" ] || { echo "falta el nombre del flujo" >&2; exit 2; }
      shift
      flow_dir=""
      for candidate in "$PWD/.dev-agent/flows/$name" "$flows_root/$name"; do
        if [ -f "$candidate/flow.json" ]; then flow_dir="$candidate"; break; fi
      done
      [ -n "$flow_dir" ] || { echo "flujo no encontrado: $name" >&2; exit 2; }
      entrypoint="$(python3 - "$flow_dir/flow.json" <<'PY'
import json, sys
from pathlib import Path
print(json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("entrypoint", ""))
PY
)"
      [ -n "$entrypoint" ] || { echo "flujo sin entrypoint: $name" >&2; exit 2; }
      [ -f "$flow_dir/$entrypoint" ] || { echo "falta el entrypoint: $flow_dir/$entrypoint" >&2; exit 2; }
      repo="$PWD"
      if git rev-parse --show-toplevel >/dev/null 2>&1; then repo="$(git rev-parse --show-toplevel)"; fi
      if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
        set -- "$repo" "$@"
      fi
      exec bash "$flow_dir/$entrypoint" "$@"
    else
      usage
      exit 2
    fi
    ;;
  update) exec bash "$KIT/scripts/update.sh" "$@" ;;
  codegraph)
    if [ $# -eq 0 ]; then exec codegraph sync "$PWD"; else exec codegraph "$@"; fi
    ;;
  memory) exec engram "$@" ;;
  *) usage; exit 2 ;;
esac
